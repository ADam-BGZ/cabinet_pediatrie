new file mode 100644
index 0000000..c58cfcc
--- /dev/null
+++ b/src/components/Faq.tsx
@@ -0,0 +1,93 @@
+"use client";
+
+import { useState } from "react";
+import { ChevronRightIcon } from "@/components/icons";
+import { useScrollAnimation } from "@/hooks/useScrollAnimation";
+
+const faqs = [
+  {
+    question: "Pourquoi choisir Dr Nada Lahbichi comme dentiste à Tanger ?",
+    answer:
+      "Dr Nada Lahbichi est reconnue pour son expertise en dentisterie esthétique, implantologie et orthodontie. Avec plus de 10 ans d'expérience, elle combine techniques de pointe et approche personnalisée pour chaque patient. Notre cabinet dispose d'équipements de dernière génération pour des soins optimaux.",
+  },
+  {
+    question: "Comment prendre rendez-vous au cabinet dentaire Tanger ?",
+    answer:
+      "Vous pouvez prendre rendez-vous par téléphone au +212 663 31 71 34, via WhatsApp, ou en remplissant le formulaire de contact sur notre site. Nous offrons des créneaux flexibles du lundi au vendredi de 9h à 19h, et le samedi de 9h à 13h.",
+  },
+  {
+    question: "Quels types de soins dentaires propose le cabinet ?",
+    answer:
+      "Notre cabinet propose une gamme complète de soins : esthétique dentaire (facettes, blanchiment), orthodontie (Invisalign, bagues), implantologie, soins parodontaux, prothèses fixes et amovibles, soins de carie, radiologie dentaire, chirurgie et urgences dentaires.",
+  },
+  {
+    question: "Est-ce que Dr Nada Lahbichi traite les urgences dentaires ?",
+    answer:
+      "Oui, nous prenons en charge les urgences dentaires. Contactez-nous au +212 663 31 71 34 pour toute situation d'urgence. Nous nous engageons à vous recevoir dans les meilleurs délais pour soulager votre douleur et traiter le problème.",
+  },
+  {
+    question: "Combien de fois faut-il consulter un dentiste par an ?",
+    answer:
+      "Il est recommandé de consulter un dentiste au moins deux fois par an pour un détartrage et un contrôle régulier. Cela permet de prévenir les problèmes dentaires avant qu'ils ne deviennent graves et de maintenir une santé bucco-dentaire optimale.",
+  },
+  {
+    question: "Le cabinet accepte-t-il les enfants ?",
+    answer:
+      "Absolument ! Notre cabinet accueille les patients de tous les âges, y compris les enfants. Nous offrons un environnement rassurant et adapté aux plus jeunes, avec des soins préventifs et des traitements adaptés à leur besoin.",
+  },
+];
+
+export function Faq() {
+  const [openIndex, setOpenIndex] = useState<number | null>(0);
+  const header = useScrollAnimation("down");
+  const list = useScrollAnimation("up");
+
+  return (
+    <section id="faq" className="py-24 lg:py-40 bg-muted">
+      <div className="max-w-4xl mx-auto px-4">
+        <div ref={header.refCallback} className={`text-center max-w-2xl mx-auto mb-16 ${header.animationClass}`}>
+          <span className="text-secondary text-sm font-semibold uppercase tracking-wider">
+            Questions Fréquentes
+          </span>
+          <h2 className="font-heading text-3xl sm:text-4xl font-bold text-foreground mt-4 mb-6">
+            Questions Fréquentes sur Votre Dentiste à Tanger
+          </h2>
+        </div>
+
+        <div ref={list.refCallback} className={`flex flex-col gap-4 ${list.animationClass}`}>
+          {faqs.map((faq, index) => (
+            <div
+              key={index}
+              className={`rounded-xl border overflow-hidden transition-all ${
+                openIndex === index
+                  ? "border-primary bg-white shadow-md"
+                  : "border-border bg-white hover:border-primary/30"
+              }`}
+            >
+              <button
+                className="w-full flex items-center justify-between p-6 text-left"
+                onClick={() => setOpenIndex(openIndex === index ? null : index)}
+              >
+                <span className="font-semibold text-foreground pr-4">
+                  {faq.question}
+                </span>
+                <ChevronRightIcon
+                  className={`w-5 h-5 text-muted-foreground flex-shrink-0 transition-transform ${
+                    openIndex === index ? "rotate-90" : ""
+                  }`}
+                />
+              </button>
+              {openIndex === index && (
+                <div className="px-6 pb-6">
+                  <p className="text-muted-foreground text-sm leading-relaxed">
+                    {faq.answer}
+                  </p>
+                </div>
+              )}
+            </div>
+          ))}
+        </div>
+      </div>
+    </section>
+  );
+}
