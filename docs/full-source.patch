     scroll-behavior: smooth;
   }
 }
+
+/* ===== KEYFRAME ANIMATIONS ===== */
+
+@keyframes fadeInLeft {
+  0% { opacity: 0; transform: translateX(-100px); }
+  100% { opacity: 1; transform: translateX(0); }
+}
+
+@keyframes fadeInRight {
+  0% { opacity: 0; transform: translateX(100px); }
+  100% { opacity: 1; transform: translateX(0); }
+}
+
+@keyframes fadeInDown {
+  0% { opacity: 0; transform: translateY(-60px); }
+  100% { opacity: 1; transform: translateY(0); }
+}
+
+@keyframes fadeInUp {
+  0% { opacity: 0; transform: translateY(60px); }
+  100% { opacity: 1; transform: translateY(0); }
+}
+
+@keyframes scroll-left {
+  0% { transform: translateX(0%); }
+  100% { transform: translateX(-50%); }
+}
+
+@keyframes fe-infinite-rotate {
+  0% { transform: rotate(0deg); }
+  100% { transform: rotate(360deg); }
+}
+
+@keyframes line-path {
+  0% { stroke-dashoffset: 350; }
+  100% { stroke-dashoffset: 0; }
+}
+
+@keyframes loading {
+  0% { width: 0%; }
+  50% { width: 100%; }
+  100% { width: 0%; }
+}
+
+@keyframes shimmer {
+  0% { background-position: -200% 0; }
+  100% { background-position: 200% 0; }
+}
+
+/* ===== SCROLL ANIMATION CLASSES ===== */
+
+.scroll-hidden {
+  opacity: 0;
+  will-change: transform, opacity;
+}
+
+.animate-fade-in-left {
+  animation: fadeInLeft 0.6s ease forwards;
+}
+
+.animate-fade-in-right {
+  animation: fadeInRight 0.6s ease forwards;
+}
+
+.animate-fade-in-down {
+  animation: fadeInDown 0.6s ease forwards;
+}
+
+.animate-fade-in-up {
+  animation: fadeInUp 0.6s ease forwards;
+}
+
+/* ===== MARQUEE ===== */
+
+.marquee-container {
+  overflow: hidden;
+  white-space: nowrap;
+}
+
+.marquee-track {
+  display: inline-flex;
+  animation: scroll-left 15s linear infinite;
+}
+
+/* ===== ROTATING ICON ===== */
+
+.animate-rotate {
+  animation: fe-infinite-rotate 10s linear infinite;
+}
+
+/* ===== SVG STROKE DRAWING ===== */
+
+.animate-stroke {
+  stroke-dasharray: 350;
+  stroke-dashoffset: 350;
+  animation: line-path 4s linear infinite alternate;
+}
+
+/* ===== TRANSITIONS (matching Elementor) ===== */
+
+.transition-default {
+  transition: background 0.3s, border 0.3s, border-radius 0.3s, box-shadow 0.3s, transform 0.4s;
+}
+
+.transition-all-fast {
+  transition: all 0.3s linear;
+}
+
+.transition-nav {
+  transition: all 0.4s ease;
+}
